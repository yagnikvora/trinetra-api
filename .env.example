# Copy to .env. All optional except UPSTOX_ACCESS_TOKEN. A clone with no .env still runs.
# Values shown are the defaults. Longer rationale for any line: git log -p .env.example

# --- Upstox (serves every live figure: quotes, chains, candles, open interest) ---
# Use an ANALYTICS token, not the OAuth access token — the latter expires daily at 03:30 IST.
# https://account.upstox.com/developer/apps -> Analytics -> Generate. A new one revokes the old.
UPSTOX_ACCESS_TOKEN=
UPSTOX_TIMEOUT_MS=8000
# Extra attempts after the first, for timeouts and dropped sockets. 0 disables.
UPSTOX_RETRIES=1

# --- Phone channels (empty = off) ---
# Carry the Trend Day signals and the two session bells. Both are read by src/alerts/.
#
# THE OLD `PULLBACK_`-PREFIXED NAMES STILL WORK. They were named for the EMA Pullback Scanner,
# which was the first thing here that sent anything and has since been removed; the unprefixed
# name wins when both are set. Nothing needs changing in an existing .env.
#
# @BotFather -> /newbot for the token; message the bot, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates. Test: GET /momentum/alerts/test
TELEGRAM_BOT_TOKEN=
# Telegram REASSIGNS this id if a plain group becomes a supergroup: sends then succeed and
# deliver nothing. Re-read it from getUpdates if a working feed goes silent for no reason.
TELEGRAM_CHAT_ID=
# Sent IN ADDITION to Telegram, so one channel can fail silently without costing the alert.
# Discord -> Edit Channel -> Integrations -> Webhooks. The URL is a credential.
DISCORD_WEBHOOK_URL=
# Only if your ISP filters api.telegram.org by SNI (many Indian ones do). Point it at a mirror
# you control — see tools/telegram-mirror.worker.js. Empty = Telegram's own host.
TELEGRAM_API_BASE=

# --- Trend Day signals (a message the moment a stock's conviction is CONFIRMED) ---
# NOTE: the four settings in this block and the next are also editable from the WEB UI, through
# the bell in the nav bar, which is the better place to change them on a live morning — it takes
# effect on the next scan and needs no restart. What the panel saves is an OVERRIDE stored in
# api/.cache/momentum/alert_settings.json; the values here remain the deployment's defaults and
# apply to every field nobody has touched. "Reset to server" in the panel gives all four back.
# Sent to the channels above. `off` silences them. Nothing can confirm before 10:30 — the
# phase machine needs 75 minutes of session, a conviction of 70 held for 20, and half an ATR of
# real displacement — and a great many stocks confirm AT 10:30, so everything confirming in the
# same 15-second scan goes out as ONE message rather than eight notifications in one second.
TREND_DAY_ALERTS=on
# Conviction floor at the moment of confirmation, 0-100. On the 2026-08-12 board 65 took 17
# confirmations down to about 7. Lower it for more, raise it for only the cleanest one-sided days.
TREND_DAY_ALERT_MIN_CONVICTION=65

# --- Ignition alerts (EXPERIMENTAL — measured as LOSING, and off for that reason) ---
# Fires the moment the TIMING layer offers an entry, which is live from the first minutes of the
# session — where the trend-day alert above cannot speak before 10:30. That gap is real: on
# 2026-08-14 the board offered IDEA at 13.67 at 09:38 and the trend-day alert could only reach it
# at 14.08 after 10:30.
#
# BUT THE FEED AS A WHOLE DOES NOT PAY. Replayed across all 208 stocks for 2026-08-14:
#   137 alerts in one day, 20 reached target (15%), 78 stopped, net -15.5% in the underlying.
#   Worse, the entry-quality gate is INVERTED — EQ 80-84 won 20% and EQ 95+ won 0% — so the one
#   dial meant to make it selective made it worse. And 137 notifications is not a feed anyone can
#   act on anyway.
# That was one rotational session (A/D 57/147, Nifty -0.12%), which is the worst kind of day for
# a breakout signal, so it is not a verdict on the idea — but it is a verdict on switching this on.
#
# Measure before trusting it, on several days:
#   npx tsx tools/trend-replay.ts --ignition --day 2026-08-14
# Anything other than `on` leaves it silent. Leave it unset until a multi-day replay says otherwise.
IGNITION_ALERTS=off
# Entry-quality floor, 0-100. Note the inversion above before raising it expecting fewer, better
# signals — on the one day measured, raising it produced fewer and WORSE.
IGNITION_ALERT_MIN_EQ=80

# --- Session bells (the 09:15 good morning and the 15:30 session-closed message) ---
# Sent to whichever channels above are configured. `off` silences both; anything else leaves
# them on. Preview either without waiting for the clock:
#   GET /momentum/alerts/test?bell=open      GET /momentum/alerts/test?bell=close
SESSION_BELL=on
# Where each bell's quote comes from. `live` fetches 100 candidates from zenquotes.io per bell
# (free, no key, 4 requests a day) and picks the best fit, so no quote ever repeats; `builtin`
# pins it to the small offline set in alerts/quotes.ts and makes no outbound call. Live falls
# back to the offline set on its own whenever the host is slow, throttled or unreachable — the
# bell always rings. Their free tier is licensed on the credit that sits beside the author name;
# `builtin` is the way to have no credit at all, not deleting it while still using their feed.
SESSION_BELL_QUOTES=live
# NSE holidays, YYYY-MM-DD, comma separated. This is the only way the bells know about a Republic
# Day, because nothing in this codebase holds a holiday calendar. It does TWO things: no bells on
# a listed day, and the closing message points at the next day the market is actually open —
# "Back at 09:15 on Tuesday" when Monday is shut.
#
# WEEKDAY CLOSURES ONLY. The four 2026 holidays that fell at a weekend (Mahashivratri 15 Feb,
# Id-Ul-Fitr 21 Mar, Independence Day 15 Aug, Diwali Laxmi Pujan 8 Nov) are left out because the
# session clock already skips Saturdays and Sundays. That last one carries the Muhurat session,
# which is an evening special and not the 09:15–15:30 day these bells ring for.
#
# REFRESH THIS EVERY JANUARY. NSE publishes the coming year around December, and one-offs are
# added mid-year with days of notice — 15 Jan 2026 was declared on 12 Jan for the Maharashtra
# civic polls, which is why it is missing from most calendar pages. Re-read on every tick, so a
# date added here takes effect without a restart. An empty value still gets weekends right; it
# will just say "tomorrow" on the eve of a holiday.
#
# 2026 (16 weekday closures):
#   Jan 15 Maharashtra civic polls · Jan 26 Republic Day · Mar 3 Holi · Mar 26 Shri Ram Navami
#   Mar 31 Shri Mahavir Jayanti · Apr 3 Good Friday · Apr 14 Ambedkar Jayanti
#   May 1 Maharashtra Day · May 28 Bakri Id · Jun 26 Muharram · Sep 14 Ganesh Chaturthi
#   Oct 2 Gandhi Jayanti · Oct 20 Dussehra · Nov 10 Diwali Balipratipada
#   Nov 24 Guru Nanak Jayanti · Dec 25 Christmas
MARKET_HOLIDAYS=2026-01-15,2026-01-26,2026-03-03,2026-03-26,2026-03-31,2026-04-03,2026-04-14,2026-05-01,2026-05-28,2026-06-26,2026-09-14,2026-10-02,2026-10-20,2026-11-10,2026-11-24,2026-12-25

# --- Scanners ---
# Trailing sessions behind the R.Factor baseline.
RVOL_WINDOW=50
# Background jobs. Set to off on any replica that is not the writer — two processes scanning
# spend the same token's request budget twice for one board. This one scheduler now also drives
# the Trend Day signals and the session bells, so turning it off silences those too.
MOMENTUM_SCHEDULER=on
# Boot-time session rebuild, ~208 candle requests, so the Trend Day board does not depend on
# this process having run since 09:15. Skips symbols it watched from the open.
MOMENTUM_SEED=on

# --- Live market feed (WebSocket) ---
# The quote tier streams over Upstox's Market Data Feed V3 instead of polling
# /v2/market-quote/quotes. Everything else — the daily baseline, option chains, the contract
# master — is still REST, because history and per-strike chains are not on a live feed.
#
# The win is latency, not request budget: Upstox counts per API, so retiring the quote calls
# buys the candle endpoint nothing. What it buys is a reading that is already in memory when
# the scan runs, instead of one up to `quoteMs` old.
#
# Set to off to go straight back to REST polling. Nothing else has to change — every caller
# falls back on its own, and the fallback path is the code that was there before.
MOMENTUM_FEED=on
# How long a streamed reading stays usable once packets stop, while the market is open. A
# liquid universe silent for this long is a broken socket, not a quiet market, so the cycle
# falls back to REST. Not applied after the close, when the feed is legitimately silent and
# the last print is the right answer until tomorrow.
FEED_STALE_MS=30000
# How much of the requested universe must be present before a cycle trusts the feed. High on
# purpose: a feed missing a tenth of the board is a subscription that did not fully land, and
# the rows it does serve would be scored against a breadth picture drawn from a smaller
# universe than the one they belong to.
FEED_MIN_COVERAGE=0.9

PORT=4100

# Which interface the API listens on. Default 127.0.0.1 — loopback only.
#
# This API has NO AUTHENTICATION and CORS is open to every origin, and nine of its routes mutate:
# `POST /momentum/baseline/rebuild` spends ~416 Upstox requests per call, and the journal routes
# edit the one record here that cannot be rebuilt. So it is not safe on a public interface, and
# it does not need to be: every consumer is server-side (the Next pages call it from server
# components, and web/lib/proxy.ts gives the browser a same-origin path), so production is
# nginx -> Next -> here over loopback.
#
# Set 0.0.0.0 ONLY where something else provides the boundary — a container namespace, or a host
# firewall you have actually verified. See deploy/README.md.
HOST=127.0.0.1

# The First-Hour Displacement alert. Fires 09:27-10:00 only, then stays silent for the session.
# Tested over 35 sessions (3 Jul - 20 Aug 2026): 98 signals, 2.8/day, 60% ended profitable,
# average +4.9% of premium against a -7.4% control for buying any liquid option at 09:46.
# Not statistically proven: t = 1.57 on 98 trades. Four signals can lose together on one morning.
DISPLACEMENT_ALERTS=on
# The rule. Every default is the value the study settled on; each was tested with a neighbourhood
# around it, so none is a lone spike. Raise MIN_TURNOVER_CR first if option spreads bite.
DISPLACEMENT_MIN_TURNOVER_CR=100
DISPLACEMENT_MIN_RVOL=5
DISPLACEMENT_MAX_RVOL=50
DISPLACEMENT_MIN_RANGE_ATR=1.0
DISPLACEMENT_MIN_MOVE_ATR=0.5
DISPLACEMENT_MAX_OFF_EXTREME_ATR=0.35
DISPLACEMENT_FROM_MIN=12
DISPLACEMENT_TO_MIN=45
DISPLACEMENT_MAX_PER_DAY=4
# Every gate above is a multiple of ATR, so the alert refuses any symbol whose baseline reading was
# carried forward from an earlier day. On 2026-08-20, 128 of 208 symbols were carried and their ATR
# was out by a median 4.3%; symbols built that morning agreed to 0.6%. Leave this off. Turning it on
# is for seeing what a stale morning WOULD have produced, not for getting more signals.
DISPLACEMENT_ALLOW_CARRIED_BASELINE=off
# Exits, as a percentage of what the contract cost. Half off at TP1, stop to breakeven, rest at
# TP2 or 15:15. Cutting the second target short is what turns this strategy negative.
DISPLACEMENT_TP1_PCT=30
DISPLACEMENT_TP2_PCT=80
DISPLACEMENT_SL_PCT=50

# ---------------------------------------------------------------------------- TRADE JOURNAL ---
# Records every alert as a position and settles it from the contract's own 1-minute candles after
# the close, so the day is read at night rather than watched. Costs no extra quota while the market
# is open — the option's instrument key rides the WebSocket feed — and about one candle request per
# open contract per day to settle. On by default; JOURNAL=off stops it recording anything.
JOURNAL=on
# The exit it applies, as a percentage of what the contract cost. These are the 36-session study's
# figures, NOT a 15/30 pair: at +30%/-15% the same signals returned -2.9% of premium a trade,
# because 2.5% each way plus a day of decay is already 8.5% and a 15-point stop has about 6.5
# points of real room. The page scores +30/-15, +30/-50 and +60/-30 alongside these on the same
# candle path, so changing them is a decision you can check rather than argue about.
JOURNAL_TP_PCT=80
JOURNAL_SL_PCT=50
# Minute of session to square off anything still open. 360 is 15:15.
JOURNAL_SQUARE_OFF_MIN=360
# Round-trip charges per lot in rupees: brokerage both ways plus STT, exchange transaction charges,
# SEBI turnover fee, GST and stamp duty. One number rather than a modelled breakdown, because the
# breakdown differs by broker and the total is what lands in the account. Take yours off a contract
# note. It is deducted from the alternative exits too, so the comparison stays fair.
JOURNAL_CHARGE_PER_LOT=120
# Lots per position. One, and note that one lot of these contracts ran 9,920 to 39,210 rupees of
# premium over the study window, so position size is set by the contract rather than by you.
JOURNAL_LOTS=1
#
# WHERE THE JOURNAL IS STORED.
#
# Unset, it is local disk only — api/.cache/momentum/journal_YYYY-MM.json — which means the record
# lives on whichever machine recorded it. Set it, and every trade is written to disk AND to
# Postgres, and any machine with the same string reads the same record. That is the whole point:
# the scanner runs on one machine during market hours and the record is read on another at night.
#
# Local disk is written FIRST and the database second. An office network that drops at 09:30 costs
# a queued push, never a trade; the queue is retried every scan tick and survives a restart.
#
# Only the journal goes to the database. The baseline, snapshots and session state stay local —
# they are 8MB of cache rebuilt from the feeds, and shipping them over the wire would slow every
# scan for nothing.
#
# Use the POOLED host if your provider gave you both (the one with "-pooler" in it). Verify with
# `npm run check-neon`, which runs every statement the app runs and prints pass/fail without ever
# printing this string. Never commit it and never paste it into a chat — api/.env is gitignored
# for exactly this reason, and see the note in .gitignore about the backup that got pushed once.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#
# How far back the boot-time reconcile pushes local history the database has never seen. This is
# what backfills the day you first configure a database.
JOURNAL_BACKFILL_DAYS=120
